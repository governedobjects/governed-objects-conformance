{
  "id": "C-REL-012",
  "title": "Unauthorized absent-edge removal is denied without canonical effect",
  "requirements": [
    "REL-AUTH-001",
    "REL-PRECEDENCE-001",
    "AUTH-BASE-001",
    "OP-NOCHANGE-001",
    "CON-NOADVANCE-001"
  ],
  "spec_revision": "draft2.1",
  "requires_capabilities": {
    "relationship_remove": true
  },
  "skip_if_missing": [
    "relationship_remove"
  ],
  "steps": [
    {
      "op": "create",
      "as": "created",
      "actor": "writer",
      "object_id": "wi-rel-012",
      "type": "conformance.work-item",
      "initial_state": {
        "title": "AuthAbsent"
      }
    },
    {
      "op": "create",
      "as": "target",
      "actor": "writer",
      "object_id": "party-rel-012",
      "type": "conformance.party",
      "initial_state": {
        "name": "Target"
      }
    },
    {
      "op": "read",
      "as": "before",
      "actor": "writer",
      "object_id": "wi-rel-012"
    },
    {
      "op": "get_history",
      "as": "history_before",
      "object_id": "wi-rel-012"
    },
    {
      "op": "remove_relationship",
      "as": "denied_remove",
      "actor": "reader",
      "object_id": "wi-rel-012",
      "relationship": {
        "type": "belongs_to",
        "target": "party-rel-012"
      }
    },
    {
      "op": "read",
      "as": "after",
      "actor": "writer",
      "object_id": "wi-rel-012"
    },
    {
      "op": "get_history",
      "as": "history_after",
      "object_id": "wi-rel-012"
    }
  ],
  "assert": [
    {
      "step": "denied_remove",
      "outcome": "AUTHORIZATION_DENIED"
    },
    {
      "relationship_set_equals": "before",
      "step": "after"
    },
    {
      "compare": "$after.semantic_view.object_version",
      "equals": "$before.semantic_view.object_version"
    },
    {
      "history_unchanged": "history_before",
      "step": "history_after"
    }
  ]
}
