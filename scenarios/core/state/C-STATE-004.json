{
  "id": "C-STATE-004",
  "title": "Conflicted mutation does not change accepted state",
  "requirements": [
    "CORE-STATE-002",
    "OP-NOCHANGE-001",
    "CON-CONFLICT-001"
  ],
  "requires_capabilities": {
    "mutable_objects": true
  },
  "steps": [
    {
      "op": "create",
      "as": "created",
      "actor": "writer",
      "object_id": "wi-state-004",
      "type": "conformance.work-item",
      "initial_state": {
        "title": "V1"
      }
    },
    {
      "op": "read",
      "as": "v1",
      "actor": "writer",
      "object_id": "wi-state-004"
    },
    {
      "op": "mutate",
      "as": "first",
      "actor": "writer",
      "object_id": "wi-state-004",
      "changes": {
        "title": "V2"
      },
      "expected_version": "$v1.semantic_view.object_version"
    },
    {
      "op": "get_history",
      "as": "history_before_stale",
      "object_id": "wi-state-004"
    },
    {
      "op": "mutate",
      "as": "stale",
      "actor": "writer",
      "object_id": "wi-state-004",
      "changes": {
        "title": "Lost"
      },
      "expected_version": "$v1.semantic_view.object_version"
    },
    {
      "op": "read",
      "as": "after",
      "actor": "writer",
      "object_id": "wi-state-004"
    },
    {
      "op": "get_history",
      "as": "history_after",
      "object_id": "wi-state-004"
    }
  ],
  "assert": [
    {
      "step": "first",
      "outcome": "ACCEPTED"
    },
    {
      "step": "stale",
      "outcome": "CONFLICT"
    },
    {
      "compare": "$after.semantic_view.accepted_state.title",
      "equals": "V2"
    },
    {
      "relationship_set_equals": "first",
      "step": "after"
    },
    {
      "compare": "$after.semantic_view.object_version",
      "equals": "$first.semantic_view.object_version"
    },
    {
      "compare": "$history_after.canonical_history",
      "equals": "$history_before_stale.canonical_history"
    }
  ]
}
