{
  "id": "C-STATE-003",
  "title": "Semantically invalid mutation does not change accepted state",
  "requirements": [
    "CORE-STATE-002",
    "OP-NOCHANGE-001",
    "TYPE-VALID-001"
  ],
  "steps": [
    {
      "op": "create",
      "as": "created",
      "actor": "writer",
      "object_id": "wi-state-003",
      "type": "conformance.work-item",
      "initial_state": {
        "title": "Valid"
      }
    },
    {
      "op": "read",
      "as": "before",
      "actor": "writer",
      "object_id": "wi-state-003"
    },
    {
      "op": "get_history",
      "as": "history_before",
      "object_id": "wi-state-003"
    },
    {
      "op": "mutate",
      "as": "invalid",
      "actor": "writer",
      "object_id": "wi-state-003",
      "changes": {
        "title": ""
      }
    },
    {
      "op": "read",
      "as": "after",
      "actor": "writer",
      "object_id": "wi-state-003"
    },
    {
      "op": "get_history",
      "as": "history_after",
      "object_id": "wi-state-003"
    }
  ],
  "assert": [
    {
      "step": "invalid",
      "outcome": "SEMANTICALLY_INVALID"
    },
    {
      "compare": "$after.semantic_view.accepted_state",
      "equals": "$before.semantic_view.accepted_state"
    },
    {
      "relationship_set_equals": "before",
      "step": "after"
    },
    {
      "compare": "$invalid.semantic_view.object_version",
      "equals": "$before.semantic_view.object_version"
    },
    {
      "compare": "$history_after.canonical_history",
      "equals": "$history_before.canonical_history"
    }
  ]
}
