{
  "id": "C-STATE-002",
  "title": "Authorization denial does not change accepted state or version",
  "requirements": [
    "CORE-STATE-002",
    "OP-NOCHANGE-001",
    "CON-NOADVANCE-001"
  ],
  "steps": [
    {
      "op": "create",
      "as": "created",
      "actor": "writer",
      "object_id": "wi-state-002",
      "type": "conformance.work-item",
      "initial_state": {
        "title": "Protected"
      }
    },
    {
      "op": "read",
      "as": "before",
      "actor": "writer",
      "object_id": "wi-state-002"
    },
    {
      "op": "get_history",
      "as": "history_before",
      "object_id": "wi-state-002"
    },
    {
      "op": "mutate",
      "as": "denied",
      "actor": "reader",
      "object_id": "wi-state-002",
      "changes": {
        "title": "Hacked"
      }
    },
    {
      "op": "read",
      "as": "after",
      "actor": "writer",
      "object_id": "wi-state-002"
    },
    {
      "op": "get_history",
      "as": "history_after",
      "object_id": "wi-state-002"
    }
  ],
  "assert": [
    {
      "step": "denied",
      "outcome": "AUTHORIZATION_DENIED"
    },
    {
      "compare": "$after.semantic_view.accepted_state",
      "equals": "$before.semantic_view.accepted_state"
    },
    {
      "relationship_set_equals": "before",
      "step": "after"
    },
    {
      "compare": "$denied.semantic_view.object_version",
      "equals": "$before.semantic_view.object_version"
    },
    {
      "compare": "$history_after.canonical_history",
      "equals": "$history_before.canonical_history"
    }
  ]
}
