{
  "id": "C-VALID-001",
  "title": "Invalid title rejected without state or version change",
  "requirements": [
    "TYPE-VALID-001",
    "OP-NOCHANGE-001",
    "CON-NOADVANCE-001"
  ],
  "steps": [
    {
      "op": "create",
      "actor": "writer",
      "object_id": "wi-valid-001",
      "type": "conformance.work-item",
      "initial_state": {
        "title": "Good"
      }
    },
    {
      "op": "read",
      "as": "before",
      "actor": "writer",
      "object_id": "wi-valid-001"
    },
    {
      "op": "get_history",
      "as": "history_before",
      "object_id": "wi-valid-001"
    },
    {
      "op": "mutate",
      "as": "invalid",
      "actor": "writer",
      "object_id": "wi-valid-001",
      "changes": {
        "title": "   "
      }
    },
    {
      "op": "read",
      "as": "after",
      "actor": "writer",
      "object_id": "wi-valid-001"
    },
    {
      "op": "get_history",
      "as": "history_after",
      "object_id": "wi-valid-001"
    }
  ],
  "assert": [
    {
      "step": "invalid",
      "outcome": "SEMANTICALLY_INVALID"
    },
    {
      "compare": "$after.semantic_view.accepted_state",
      "equals": "$before.semantic_view.accepted_state"
    },
    {
      "relationship_set_equals": "before",
      "step": "after"
    },
    {
      "compare": "$invalid.semantic_view.object_version",
      "equals": "$before.semantic_view.object_version"
    },
    {
      "compare": "$history_after.canonical_history",
      "equals": "$history_before.canonical_history"
    }
  ]
}
