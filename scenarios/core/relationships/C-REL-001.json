{
  "id": "C-REL-001",
  "title": "Accepted relationship add visible with version advance",
  "requirements": [
    "REL-ACCEPT-001",
    "REL-EDGE-001",
    "CON-ADVANCE-001",
    "OP-HIST-001",
    "EVT-CONTENT-001"
  ],
  "requires_capabilities": {
    "relationship_add": true
  },
  "skip_if_missing": [
    "relationship_add"
  ],
  "steps": [
    {
      "op": "create",
      "as": "created",
      "actor": "writer",
      "object_id": "wi-rel-001",
      "type": "conformance.work-item",
      "initial_state": {
        "title": "Rel"
      }
    },
    {
      "op": "read",
      "as": "before",
      "actor": "writer",
      "object_id": "wi-rel-001"
    },
    {
      "op": "add_relationship",
      "as": "added",
      "actor": "writer",
      "object_id": "wi-rel-001",
      "relationship": {
        "type": "owned_by",
        "target": "party-1"
      }
    },
    {
      "op": "get_history",
      "as": "history",
      "object_id": "wi-rel-001"
    }
  ],
  "assert": [
    {
      "step": "added",
      "outcome": "ACCEPTED"
    },
    {
      "relationship_exists": {
        "type": "owned_by",
        "target": "party-1"
      },
      "step": "added"
    },
    {
      "compare": "$added.semantic_view.object_version",
      "not_equals": "$before.semantic_view.object_version"
    },
    {
      "history_contains": {
        "effect": "relationship_added",
        "object_version": "$added.semantic_view.object_version",
        "relationship_type": "owned_by",
        "relationship_target": "party-1"
      },
      "step": "history"
    },
    {
      "history_all_fields_not_null": [
        "effect",
        "canonical_identity",
        "type_identity",
        "type_version",
        "object_version"
      ],
      "step": "history"
    }
  ]
}
