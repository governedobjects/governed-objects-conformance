{
  "id": "C-REL-007",
  "title": "Invalid relationship removal has no canonical effect",
  "requirements": [
    "REL-REMOVE-001",
    "OP-NOCHANGE-001",
    "CON-NOADVANCE-001"
  ],
  "requires_capabilities": {
    "relationship_add": true,
    "relationship_remove": true
  },
  "skip_if_missing": [
    "relationship_add",
    "relationship_remove"
  ],
  "steps": [
    {
      "op": "create",
      "as": "created",
      "actor": "writer",
      "object_id": "wi-rel-007",
      "type": "conformance.work-item",
      "initial_state": {
        "title": "RelInvalid"
      }
    },
    {
      "op": "add_relationship",
      "as": "added",
      "actor": "writer",
      "object_id": "wi-rel-007",
      "relationship": {
        "type": "depends_on",
        "target": "wi-other"
      }
    },
    {
      "op": "read",
      "as": "before",
      "actor": "writer",
      "object_id": "wi-rel-007"
    },
    {
      "op": "get_history",
      "as": "history_before",
      "object_id": "wi-rel-007"
    },
    {
      "op": "remove_relationship",
      "as": "invalid",
      "actor": "writer",
      "object_id": "wi-rel-007",
      "relationship": {
        "type": "",
        "target": "wi-other"
      }
    },
    {
      "op": "read",
      "as": "after",
      "actor": "writer",
      "object_id": "wi-rel-007"
    },
    {
      "op": "get_history",
      "as": "history_after",
      "object_id": "wi-rel-007"
    }
  ],
  "assert": [
    {
      "step": "added",
      "outcome": "ACCEPTED"
    },
    {
      "step": "invalid",
      "outcome": "SEMANTICALLY_INVALID"
    },
    {
      "relationship_set_equals": "before",
      "step": "after"
    },
    {
      "compare": "$after.semantic_view.object_version",
      "equals": "$before.semantic_view.object_version"
    },
    {
      "compare": "$history_after.canonical_history",
      "equals": "$history_before.canonical_history"
    }
  ]
}
