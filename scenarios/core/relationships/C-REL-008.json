{
  "id": "C-REL-008",
  "title": "Stale relationship removal conflicts without canonical effect",
  "requirements": [
    "REL-REMOVE-001",
    "CON-CONFLICT-001",
    "OP-NOCHANGE-001",
    "CON-NOADVANCE-001"
  ],
  "requires_capabilities": {
    "relationship_add": true,
    "relationship_remove": true
  },
  "skip_if_missing": [
    "relationship_add",
    "relationship_remove"
  ],
  "steps": [
    {
      "op": "create",
      "as": "created",
      "actor": "writer",
      "object_id": "wi-rel-008",
      "type": "conformance.work-item",
      "initial_state": {
        "title": "RelStale"
      }
    },
    {
      "op": "read",
      "as": "v1",
      "actor": "writer",
      "object_id": "wi-rel-008"
    },
    {
      "op": "add_relationship",
      "as": "added",
      "actor": "writer",
      "object_id": "wi-rel-008",
      "relationship": {
        "type": "owned_by",
        "target": "party-1"
      }
    },
    {
      "op": "read",
      "as": "before",
      "actor": "writer",
      "object_id": "wi-rel-008"
    },
    {
      "op": "get_history",
      "as": "history_before",
      "object_id": "wi-rel-008"
    },
    {
      "op": "remove_relationship",
      "as": "stale",
      "actor": "writer",
      "object_id": "wi-rel-008",
      "relationship": {
        "type": "owned_by",
        "target": "party-1"
      },
      "expected_version": "$v1.semantic_view.object_version"
    },
    {
      "op": "read",
      "as": "after",
      "actor": "writer",
      "object_id": "wi-rel-008"
    },
    {
      "op": "get_history",
      "as": "history_after",
      "object_id": "wi-rel-008"
    }
  ],
  "assert": [
    {
      "step": "added",
      "outcome": "ACCEPTED"
    },
    {
      "step": "stale",
      "outcome": "CONFLICT"
    },
    {
      "relationship_set_equals": "before",
      "step": "after"
    },
    {
      "compare": "$after.semantic_view.object_version",
      "equals": "$before.semantic_view.object_version"
    },
    {
      "compare": "$history_after.canonical_history",
      "equals": "$history_before.canonical_history"
    }
  ]
}
