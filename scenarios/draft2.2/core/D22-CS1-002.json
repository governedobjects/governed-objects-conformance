{
  "id": "D22-CS1-002",
  "title": "Relationship add then remove gives three pairwise-distinct Object Versions; the first is stale",
  "cs": [
    "CS-1"
  ],
  "requirements": [
    "CON-UNIQUE-001",
    "CON-ADVANCE-001",
    "CON-CONFLICT-001",
    "REL-PRECOND-001"
  ],
  "modality": "MUST",
  "steps": [
    {
      "op": "create",
      "as": "c",
      "actor": "writer",
      "object_id": "cs1-r",
      "type": "conformance.work-item",
      "initial_state": {
        "title": "cs1-rel"
      },
      "precondition_outcomes": [
        "ACCEPTED"
      ]
    },
    {
      "op": "add_relationship",
      "as": "added",
      "actor": "writer",
      "object_id": "cs1-r",
      "relationship": {
        "type": "owned_by",
        "target": "party-cs1"
      },
      "precondition_outcomes": [
        "ACCEPTED"
      ]
    },
    {
      "op": "remove_relationship",
      "as": "removed",
      "actor": "writer",
      "object_id": "cs1-r",
      "relationship": {
        "type": "owned_by",
        "target": "party-cs1"
      },
      "precondition_outcomes": [
        "ACCEPTED"
      ]
    },
    {
      "op": "get_history",
      "as": "h",
      "object_id": "cs1-r"
    },
    {
      "op": "add_relationship",
      "as": "stale_first",
      "actor": "writer",
      "object_id": "cs1-r",
      "relationship": {
        "type": "owned_by",
        "target": "party-cs1"
      },
      "expected_version": "$c.semantic_view.object_version"
    },
    {
      "op": "get_history",
      "as": "h2",
      "object_id": "cs1-r"
    }
  ],
  "assert": [
    {
      "relationship_set_empty": true,
      "step": "removed",
      "label": "relationship set recurs"
    },
    {
      "distinct": [
        "$c.semantic_view.object_version",
        "$added.semantic_view.object_version",
        "$removed.semantic_view.object_version"
      ],
      "requirements": [
        "CON-UNIQUE-001",
        "CON-ADVANCE-001"
      ]
    },
    {
      "outcome_in": {
        "step": "stale_first",
        "outcomes": [
          "CONFLICT"
        ]
      },
      "requirements": [
        "CON-CONFLICT-001",
        "REL-PRECOND-001"
      ]
    },
    {
      "observer_unchanged": {
        "before": "h",
        "after": "h2"
      },
      "requirements": [
        "CON-NOADVANCE-001"
      ]
    },
    {
      "lineage": {
        "object_id": "cs1-r",
        "history": "h2"
      },
      "requirements": [
        "CORE-LINEAGE-001"
      ]
    }
  ]
}
