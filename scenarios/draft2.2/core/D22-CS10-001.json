      "label": "object is at the declared ceiling",
      "requirements": []
    },
    {
      "outcome_in": {
        "step": "u",
        "outcomes": [
          "REFUSED"
        ]
      },
      "requirements": [
        "OP-OUTCOME-001"
      ]
    },
    {
      "outcome_in": {
        "step": "t",
        "outcomes": [
          "REFUSED"
        ]
      },
      "requirements": [
        "OP-OUTCOME-001"
      ]
    },
    {
      "outcome_in": {
        "step": "ra",
        "outcomes": [
          "REFUSED"
        ]
      },
      "requirements": [
        "OP-OUTCOME-001"
      ]
    },
    {
      "outcome_in": {
        "step": "rr",
        "outcomes": [
          "REFUSED"
        ]
      },
      "requirements": [
        "OP-OUTCOME-001"
      ]
    },
    {
      "observer_unchanged": {
        "before": "h",
        "after": "h2"
      },
      "requirements": [
        "OP-NOCHANGE-001",
        "CON-NOADVANCE-001"
      ]
    }
  ]
}
